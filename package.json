{
  "name": "patient-slot-review-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Clickable prototype of the SphinxMatch Patient pages and Patient Slot Review (Thursday meeting board). Test data only, no backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
